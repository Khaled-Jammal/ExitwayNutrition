PORT=3001
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-10-characters
SUPABASE_URL=https://your-project.supabase.co
# Optional read-only fallback. Admin writes require the server-only secret key below.
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-only secret key; never prefix this with VITE_ or expose it to the browser.
SUPABASE_SECRET_KEY=your-supabase-secret-key
